{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "headers": [
        {
          "value": "no-referrer",
          "key": "Referrer-Policy"
        }
      ],
      "source": "/(.*)"
    }
  ]
}
