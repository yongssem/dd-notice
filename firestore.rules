rules_version = '2';

// Parent invitations are verified by /api/parent on every request.
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function ownsClass(classId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/classes/$(classId)).data.teacherUid == request.auth.uid;
    }

    match /classes/{classId} {
      allow create: if isSignedIn()
        && request.resource.data.teacherUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.teacherName is string;
      allow read, delete: if isSignedIn()
        && resource.data.teacherUid == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.teacherUid == request.auth.uid
        && request.resource.data.teacherUid == resource.data.teacherUid;

      match /parents/{parentId} {
        allow read, write: if ownsClass(classId);
      }

      match /notices/{noticeId} {
        allow read, write: if ownsClass(classId);
      }
    }
  }
}
